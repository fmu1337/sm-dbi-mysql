# Pins for every build. Changing a value changes the artifacts: bump the version in
# README.md and CHANGELOG.md too.

# Upstream extensions/mysql (vendor/sourcemod-mysql, see vendor/VENDOR.md).
SM_MYSQL_PIN=b34de51b8c7f92fc2a7242fc0195e2d64a69cefd

# metamod-source 1.10-dev head: only core/sourcehook headers are used.
MMSOURCE_REPO=https://github.com/alliedmodders/metamod-source
MMSOURCE_COMMIT=80e8ff0be3b62386bbd6f937e97b819ef8be6dd2

# MariaDB Connector/C 3.4.9 (AlliedModders release, static libmariadbclient.a, LGPL-2.1).
MARIADB_RELEASE=v3.4.9-sm.5
MARIADB_DIR=mariadb-connector-c-3.4.9-x86
MARIADB_URL=https://github.com/alliedmodders/mariadb-connector-c/releases/download/v3.4.9-sm.5/mariadb-connector-c-3.4.9-linux-x86.tar.gz
MARIADB_SHA256=147d96bd4fb3579acd99e6a8eed327f58c3b0c05544decb0d98ce434f3826ee6

# OpenSSL 3.0 LTS (Apache-2.0), built statically from source for i386.
OPENSSL_VERSION=3.0.22
OPENSSL_URL=https://github.com/openssl/openssl/releases/download/openssl-3.0.22/openssl-3.0.22.tar.gz
OPENSSL_SHA256=67ebca7e50d17383028045486653492195b83db95f8558709701bb47b5c1ef81

# SourceMod 1.13 release drop: only spcomp and include/ are used (to compile the test plugin).
SPCOMP_DROP_URL="https://www.sourcemod.net/latest.php?version=1.13&os=linux"
SPCOMP_DROP_SHA256=2f7309c9dbb17158516bf3daa87af7a473f37d4838f7d0f3738b1b5bf87b455c

# SourceMod 1.7 release drop (SourcePawn 1.7 compiler): compiles the test plugin with the
# pre-1.8 SQL_TQuery callback type. Pinned by sha256; the URL is the 1.7 "latest" drop.
SPCOMP17_DROP_URL="https://www.sourcemod.net/latest.php?version=1.7&os=linux"
SPCOMP17_DROP_SHA256=1b661b251f716e745dd1c0b73717a4d7e384161d677d5d4c4d19efbbde0cf65f
